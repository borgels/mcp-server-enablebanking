# One instance serves ONE company. Everything below is read from the
# environment only — never from tool arguments.

# The company this instance is pinned to: a key under `companies` in the
# account registry.
ENABLEBANKING_COMPANY=aaa

# Enable Banking application (control panel → Applications). The private key is
# a mounted file, not an env value.
ENABLEBANKING_APPLICATION_ID=
ENABLEBANKING_PRIVATE_KEY_PATH=/secrets/enablebanking.pem

# The account registry: which IBAN belongs to which company. One JSON file for
# all companies (see deploy/accounts.example.json); validated at startup.
ENABLEBANKING_ACCOUNTS_PATH=/config/accounts.json

# Bank sessions are stored encrypted (AES-256-GCM) in the data dir. The key also
# signs the consent state. openssl rand -hex 32 — keep it stable, or every
# consent has to be redone with MitID.
ENABLEBANKING_DATA_DIR=/data
ENABLEBANKING_ENCRYPTION_KEY=

# Consent management (start/complete/refresh/revoke). Off = read-only tools only.
ENABLEBANKING_ENABLE_CONSENT=false
# Must be one of the application's registered redirect URLs.
ENABLEBANKING_REDIRECT_URL=https://consent.example.com/bank-consent
# true: answer GET on the redirect URL's path, complete the consent there and show
# a confirmation page (route only that path past the gateway). false: the admin
# pastes the address into enablebanking_complete_consent.
ENABLEBANKING_CONSENT_CALLBACK=false
# Optional https link for the confirmation page's "back" button.
ENABLEBANKING_RETURN_URL=
# Optional UPN allowlist for the consent tools, on top of the gateway's duty
# group. Empty = the gateway alone decides.
ENABLEBANKING_CONSENT_ADMINS=

# Behind an authenticating MCP gateway: honour X-MCP-User (and refuse requests
# without it). Leave false for stdio; ENABLEBANKING_DEFAULT_USER names the user then.
ENABLEBANKING_TRUST_FORWARDED_USER=false
ENABLEBANKING_DEFAULT_USER=

# Seconds a balance/transaction answer is reused. Banks may cap reads made
# without the account holder present (PSD2: as few as 4 per account per day).
ENABLEBANKING_CACHE_SECONDS=300
ENABLEBANKING_TIMEOUT_MS=30000
# JSON-lines audit of every tool call (who, company, tool, account; no data).
ENABLEBANKING_AUDIT_LOG=/data/audit.jsonl

# Streamable HTTP transport. Binds to loopback and expects the gateway in front.
MCP_HTTP_HOST=127.0.0.1
PORT=3000
MCP_MAX_BODY_BYTES=10485760
MCP_ALLOWED_ORIGINS=
MCP_ALLOW_ANY_ORIGIN=false
MCP_HTTP_TOKEN=
