{
  "name": "mcp-server-enablebanking",
  "version": "0.7.0",
  "description": "Read-only MCP server for bank accounts via Enable Banking (PSD2 AIS), hard-scoped to one company per instance.",
  "type": "module",
  "main": "./dist/transports/stdio.js",
  "exports": {
    ".": "./dist/transports/stdio.js",
    "./gateway": {
      "types": "./dist/gateway.d.ts",
      "default": "./dist/gateway.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "docs",
    ".env.example"
  ],
  "bin": {
    "mcp-server-enablebanking": "./dist/transports/stdio.js"
  },
  "scripts": {
    "build": "tsup src/server.ts src/transports/stdio.ts src/transports/http.ts src/gateway.ts --format esm --dts --clean --sourcemap",
    "dev": "tsx src/transports/stdio.ts",
    "dev:http": "tsx src/transports/http.ts",
    "check:accounts": "tsx src/enablebanking/check-registry.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run typecheck && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/borgels/mcp-server-enablebanking.git"
  },
  "keywords": [
    "mcp",
    "enable-banking",
    "psd2",
    "ais",
    "bank",
    "transactions"
  ],
  "author": "",
  "license": "FSL-1.1-ALv2",
  "engines": {
    "node": ">=20.11"
  },
  "bugs": {
    "url": "https://github.com/borgels/mcp-server-enablebanking/issues"
  },
  "homepage": "https://github.com/borgels/mcp-server-enablebanking#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "entities": "7.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "ip-address": "^10.3.1",
    "hono": "^4.13.19",
    "@hono/node-server": "^2.1.8",
    "fast-uri": "^3.1.9",
    "qs": "^6.17.1",
    "body-parser": "^2.4.0"
  }
}
